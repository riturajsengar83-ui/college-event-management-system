# =============================================================================
# College Event Management System - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Then restart the backend: npm start
# =============================================================================

# ---- Server ----
PORT=3000
JWT_SECRET=change-this-to-a-random-secret-for-production

# ---- Admin account (seeded on boot) ----
# Optional. Set these on your host (e.g. Render) to use your own admin login.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=you@college.edu
# ADMIN_PASSWORD=choose-a-strong-password

# ---- Email (SMTP) ----
# Required for real password-reset OTP emails.
# If you leave these blank, the app runs in DEMO mode and prints OTPs to the console.

# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=aflk hdix emwx mobg   (NOT your Gmail password)
#   SMTP_FROM=yourname@gmail.com

# Outlook / Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@college.edu
#   SMTP_PASS=your-email-password
#   SMTP_FROM=yourname@college.edu

# College SMTP example (ask your IT department):
#   SMTP_HOST=smtp.college.ac.in
#   SMTP_PORT=25   (or 587 / 465)
#   SMTP_USER=your-college-id
#   SMTP_PASS=your-college-password
#   SMTP_FROM=noreply@college.ac.in

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OTP expires after this many minutes
OTP_TTL_MIN=10
